# Copy to .env and fill the values before starting Compose.
DB_PASSWORD=replace-with-a-random-application-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
ADMIN_EMAIL=admin@hospital.test
# Generate using: java -cp target/classes com.security.Passwords
# Single quotes preserve literal $ characters in a PBKDF2 representation.
ADMIN_PASSWORD_HASH='paste-generated-pbkdf2-hash-here'
DEMO_MODE=false
APP_PORT=8080
DB_POOL_SIZE=10
HOSPITAL_ZONE=Asia/Kolkata
# Set true when accessed through a trusted HTTPS deployment.
SECURE_COOKIES=false
