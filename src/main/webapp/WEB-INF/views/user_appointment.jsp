<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Book a slot | HMS</title><%@include file="component/allcss.jsp"%></head><body><%@include file="component/navbar.jsp"%><main id="main-content" class="page-main"><div class="container">
<h1 class="page-title">Choose your appointment slot.</h1><p class="page-intro">Published slots last 30 minutes. All times use <c:out value="${hospitalZone}"/>. Your selected slot is held while the doctor reviews your request.</p>
<%@include file="component/messages.jsp"%>
<form action="user_appointment.jsp" method="get" class="specialty-form mb-4"><div><label class="form-label" for="filter">Filter doctors</label><select id="filter" name="doctorId" class="form-select"><c:forEach var="d" items="${doctors}"><option value="${d.id}"><c:out value="${d.fullName}"/> · <c:out value="${d.specialist}"/></option></c:forEach></select></div><button class="btn btn-outline-primary">Find slots</button><a href="user_appointment.jsp">All doctors</a></form>
<section class="form-panel"><c:choose><c:when test="${empty slots}"><h2>No published slots are available.</h2><p>Choose another doctor or check again later. Hospital staff publish availability from their slot management page.</p></c:when><c:otherwise>
<form action="appAppointment" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="requestKey" value="${bookingKey}">
<div class="row g-3">
<div class="col-12"><label for="slot" class="form-label">Available doctor and time</label><select id="slot" class="form-select" name="slotId" required><option value="">Choose a published half-hour slot</option><c:forEach var="slot" items="${slots}"><option value="${slot.id}"><c:out value="${slot.label}"/></option></c:forEach></select></div>
<div class="col-md-6"><label for="fullname" class="form-label">Patient full name</label><input id="fullname" class="form-control" name="fullname" required maxlength="120" value="<c:out value='${not empty appointmentForm ? appointmentForm.fullname : userObj.fullName}'/>"></div>
<div class="col-md-6"><label for="gender" class="form-label">Gender</label><select id="gender" name="gender" class="form-select" required><c:forEach var="g" items="${['male','female','other','prefer not to say']}"><option value="${g}" ${appointmentForm.gender eq g ? 'selected' : ''}><c:out value="${g}"/></option></c:forEach></select></div>
<div class="col-md-6"><label for="age" class="form-label">Age</label><input id="age" name="age" type="number" class="form-control" required min="0" max="120" value="<c:out value='${appointmentForm.age}'/>"></div>
<div class="col-md-6"><label for="email" class="form-label">Email</label><input id="email" name="email" type="email" class="form-control" required maxlength="254" value="<c:out value='${not empty appointmentForm ? appointmentForm.email : userObj.email}'/>"></div>
<div class="col-12"><label for="phone" class="form-label">Phone</label><input id="phone" name="phno" type="tel" class="form-control" required maxlength="20" value="<c:out value='${appointmentForm.phno}'/>"></div>
<div class="col-12"><label for="reason" class="form-label">Reason for visit</label><textarea id="reason" name="diseases" class="form-control" required rows="3" maxlength="500"><c:out value="${appointmentForm.diseases}"/></textarea></div>
<div class="col-12"><label for="address" class="form-label">Address</label><textarea id="address" name="address" class="form-control" required rows="2" maxlength="500"><c:out value="${appointmentForm.address}"/></textarea></div>
</div><button class="btn btn-primary mt-4">Reserve this slot</button></form></c:otherwise></c:choose><c:remove var="appointmentForm" scope="session"/></section></div></main></body></html>
