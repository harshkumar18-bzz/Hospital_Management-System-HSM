<%@taglib prefix="c" uri="jakarta.tags.core"%>
<h1 class="page-title">Appointment #${appointment.id}</h1>
<%@include file="messages.jsp"%>
<section class="form-panel"><h2><c:out value="${appointment.fullName}"/></h2><p><strong><c:out value="${appointment.status}"/></strong> · <c:out value="${appointment.slotTime}"/> · <c:out value="${appointment.doctorName}"/></p>
<p><c:out value="${appointment.age}"/> years · <c:out value="${appointment.gender}"/></p><p><strong>Contact</strong><br><c:out value="${appointment.email}"/><br><c:out value="${appointment.phone}"/><br><c:out value="${appointment.address}"/></p><p><strong>Reason</strong><br><c:out value="${appointment.reason}"/></p>
<div class="d-flex flex-wrap gap-3"><c:forEach var="action" items="${allowedActions}"><form action="${pageContext.request.contextPath}/appointmentState" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${appointment.id}"><input type="hidden" name="status" value="${action}"><button class="btn btn-outline-primary" type="submit"><c:out value="${action}"/></button></form></c:forEach></div></section>
<c:if test="${not empty docObj and appointment.status ne 'CANCELLED'}"><section class="form-panel mt-4"><h2>Add a consultation note</h2><p>Notes are appended to the history and are visible to this patient.</p><form action="${pageContext.request.contextPath}/updateStatus" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${appointment.id}"><label for="note" class="form-label">Note for the patient</label><textarea id="note" name="comm" class="form-control" rows="4" required maxlength="1000"></textarea><button class="btn btn-primary mt-3">Add note</button></form></section></c:if>
<section class="form-panel mt-4"><h2>Consultation history</h2><c:if test="${empty notes}"><p>No consultation notes yet.</p></c:if><c:forEach var="note" items="${notes}"><article class="mb-4"><strong><c:out value="${note.author}"/></strong> · <c:out value="${note.createdAt}"/><p class="preserve-lines"><c:out value="${note.body}"/></p></article></c:forEach></section>
<section class="form-panel mt-4"><h2>Activity history</h2><c:forEach var="event" items="${events}"><p><c:out value="${event.createdAt}"/> · <c:out value="${event.actorRole}"/> · <c:out value="${event.action}"/> · <c:out value="${event.toStatus}"/></p></c:forEach></section>