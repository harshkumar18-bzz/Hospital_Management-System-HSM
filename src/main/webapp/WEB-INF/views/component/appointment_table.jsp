<%@taglib prefix="c" uri="jakarta.tags.core"%>
<c:choose><c:when test="${empty appointments}"><div class="empty-state"><h2>No appointments on this page.</h2><p>New appointment records will appear here.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table"><caption class="visually-hidden">Appointments, 20 per page</caption><thead><tr><th>Reference / patient</th><th>Doctor / time</th><th>Reason</th><th>Status</th><th>Latest note</th><th>Details</th></tr></thead><tbody>
<c:forEach var="a" items="${appointments}"><tr><td>#${a.id}<br><c:out value="${a.fullName}"/></td><td><c:out value="${a.doctorName}"/><br><c:out value="${a.slotTime}"/></td><td><c:out value="${a.reason}"/></td><td><span class="status-pending"><c:out value="${a.status}"/></span></td><td><c:out value="${a.latestNote}" default="No consultation notes yet."/></td><td><a href="${detailsPath}?id=${a.id}" class="btn btn-sm btn-outline-primary">Open</a></td></tr></c:forEach>
</tbody></table></div></c:otherwise></c:choose>
<nav aria-label="Appointment pages" class="mt-4 d-flex gap-3"><c:if test="${page gt 1}"><a href="?page=${page-1}">Previous</a></c:if><span>Page ${page}</span><c:if test="${hasNext}"><a href="?page=${page+1}">Next</a></c:if></nav>