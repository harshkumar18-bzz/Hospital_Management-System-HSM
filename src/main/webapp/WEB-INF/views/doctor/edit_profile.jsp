<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My profile | HMS</title><%@include file="../component/allcss.jsp"%></head><body><%@include file="navbar.jsp"%><main id="main-content" class="page-main"><div class="container"><h1 class="page-title">My profile</h1><%@include file="../component/messages.jsp"%><section class="form-panel"><form action="../doctorUpdateProfile" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><%@include file="../component/doctor_form.jsp"%><button class="btn btn-primary mt-4">Save profile</button></form></section><section class="form-panel mt-4"><h2>Change password</h2><p>Changing your password signs out all existing doctor sessions.</p><form action="../docChangePassword" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><label class="form-label" for="old">Current password</label><input id="old" name="oldPassword" type="password" class="form-control mb-3" required maxlength="128" autocomplete="current-password"><label class="form-label" for="new">New password</label><input id="new" name="newPassword" type="password" class="form-control mb-3" required minlength="8" maxlength="128" autocomplete="new-password"><button class="btn btn-primary">Change password</button></form></section></div></main></body></html>
