<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage slots | HMS</title><%@include file="../component/allcss.jsp"%></head><body><%@include file="navbar.jsp"%><main id="main-content" class="page-main"><div class="container"><h1 class="page-title">Manage appointment slots</h1><p>Slots last 30 minutes. Choose a future :00 or :30 start within 90 days. Time zone: <c:out value="${hospitalZone}"/>.</p><%@include file="../component/messages.jsp"%>
<section class="form-panel"><h2>Publish a slot</h2><form action="../publishSlot" method="post" class="row g-3"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><div class="col-md-5"><label class="form-label" for="start">Start date and time</label><input id="start" name="startsAt" type="datetime-local" step="1800" class="form-control" required></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Publish</button></div></form></section>
<section class="appointments-panel mt-4"><h2>Available published slots</h2><p>Reserved and withdrawn slots are excluded. Cancel an appointment from its details page to release its slot.</p><c:forEach var="slot" items="${slots}"><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><span><c:out value="${slot.label}"/></span><form action="../withdrawSlot" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="slotId" value="${slot.id}"><button class="btn btn-sm btn-outline-primary">Withdraw</button></form></div></c:forEach></section></div></main></body></html>
