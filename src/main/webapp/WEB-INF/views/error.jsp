<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Request could not be completed | HMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/component/app.css"></head><body><main class="container page-main"><section class="form-panel"><h1>We couldn't complete this request.</h1><p role="alert"><c:out value="${errorMessage}"/></p><p>Please return to the relevant form and try again.</p><p><a href="${pageContext.request.contextPath}/user_appointment.jsp">Choose an appointment slot</a> · <a href="${pageContext.request.contextPath}/user_Login.jsp">Patient sign in</a> · <a href="${pageContext.request.contextPath}/doctor.jsp">Doctor sign in</a> · <a href="${pageContext.request.contextPath}/admin.jsp">Admin sign in</a></p><small>Request reference: <c:out value="${requestId}"/></small></section></main></body></html>